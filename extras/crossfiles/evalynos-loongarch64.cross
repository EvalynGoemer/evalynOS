[host_machine]
system = 'evalynos'
kernel = 'evalynos'
cpu_family = 'loongarch64'
cpu = 'loongarch64'
endian = 'little'

[binaries]
c = 'clang'
c_ld = 'lld'
ar = 'llvm-ar'
strip = 'llvm-strip'
pkg-config = 'loongarch64-unknown-evalynos-pkg-config'

[built-in options]
c_args = ['--target=loongarch64-unknown-evalynos', '-march=la464', '--sysroot=${SYSROOT_DIR}']
c_link_args = ['--target=loongarch64-unknown-evalynos', '--sysroot=${SYSROOT_DIR}']

[properties]
needs_exe_wrapper = true
sys_root = '${SYSROOT_DIR}'
