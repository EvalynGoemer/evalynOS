[host_machine]
system = 'evalynos'
kernel = 'evalynos'
cpu_family = 'riscv64'
cpu = 'riscv64'
endian = 'little'

[binaries]
c = ['clang', '--target=riscv64-unknown-evalynos', '--sysroot=${SYSROOT_DIR}', '-march=rv64gc_zbb_zba']
cpp = ['clang++', '--target=riscv64-unknown-evalynos', '--sysroot=${SYSROOT_DIR}', '-march=rv64gc_zbb_zba']
c_ld = 'lld'
ar = 'llvm-ar'
strip = 'llvm-strip'
pkg-config = 'riscv64-unknown-evalynos-pkg-config'

[properties]
needs_exe_wrapper = true
sys_root = '${SYSROOT_DIR}'
