[host_machine]
system = 'evalynos'
kernel = 'evalynos'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[binaries]
c = ['clang', '--target=x86_64-unknown-evalynos', '--sysroot=${SYSROOT_DIR}']
cpp = ['clang++', '--target=x86_64-unknown-evalynos', '--sysroot=${SYSROOT_DIR}']
c_ld = 'lld'
ar = 'llvm-ar'
strip = 'llvm-strip'
pkg-config = 'x86_64-unknown-evalynos-pkg-config'

[properties]
needs_exe_wrapper = true
sys_root = '${SYSROOT_DIR}'
