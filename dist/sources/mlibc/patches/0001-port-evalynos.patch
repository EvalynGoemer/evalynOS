+#pragma once
+
+#include <mlibc/sysdep-signatures.hpp>
+
+namespace mlibc {
+
+struct EvalynOSSysdepTags :
+    LibcPanic,
+    LibcLog,
+    Isatty,
+    Write,
+    TcbSet,
+    AnonAllocate,
+    AnonFree,
+    Seek,
+    Exit,
+    Close,
+    FutexWake,
+    FutexWait,
+    Read,
+    Open,
+    VmMap,
+    VmUnmap,
+    ClockGet,
+    Sleep
+{};
+
+template<typename Tag>
+using Sysdeps = SysdepOf<EvalynOSSysdepTags, Tag>;
