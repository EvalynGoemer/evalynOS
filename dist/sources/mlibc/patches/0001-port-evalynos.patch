diff --git a/sysdeps/evalynos/sysdeps.cpp b/sysdeps/evalynos/sysdeps.cpp
new file mode 100644
index 00000000..98f3fd4a
--- /dev/null
+++ b/sysdeps/evalynos/sysdeps.cpp
@@ -0,0 +1,123 @@
+#include <abi-bits/errno.h>
+#include <bits/ensure.h>
+#include <bits/syscall.h>
+#include <mlibc/all-sysdeps.hpp>
+#include <string.h>
+#include <limits>
+
+#define STUB()                                 \
+    ({                                         \
+        __ensure(!"STUB function was called"); \
+        __builtin_unreachable();               \
+    })
+
+namespace mlibc {
+
+void Sysdeps<LibcPanic>::operator()() {
+    sysdep<LibcLog>("!!! mlibc panic !!!");
+    sysdep<Exit>(-1);
+    __builtin_trap();
+}
+
+void Sysdeps<LibcLog>::operator()(const char* msg) {
+    ssize_t unused;
+    sysdep<Write>(2, msg, strlen(msg), &unused);
+}
+
+int Sysdeps<AnonAllocate>::operator()(size_t size, void** pointer) {
+    auto out = syscall1(SYS_ALLOC_ANON, size);
+    if (out.error != 0)
+        return ENOMEM;
+    *pointer = (void*)out.retval;
+    return 0;
+}
+
+int Sysdeps<AnonFree>::operator()(void* memory, unsigned long size) {
+    syscall2(SYS_FREE_ANON, (size_t)memory, size);
+    return 0;
+}
+
+void Sysdeps<Exit>::operator()(int status) {
+    syscall1(SYS_EXIT, status);
+    __builtin_unreachable();
+}
+
+int Sysdeps<ClockGet>::operator()(int clock, time_t* secs, long* nanos) {
+    switch (clock) {
+        case CLOCK_MONOTONIC:
+        case CLOCK_MONOTONIC_RAW:
+        case CLOCK_MONOTONIC_COARSE: {
+            uint64_t ns = syscall0(SYS_GET_NS).retval;
+            *secs = (ns / 1000000000ull);
+            *nanos = (ns % 1000000000ull);
+            return 0;
+        }
+        default: STUB();
+    }
+}
+
+int Sysdeps<Sleep>::operator()(time_t* secs, long* nanos) {
+    size_t ns = size_t(*secs) * 1000000000ull + size_t(*nanos);
+    auto out = syscall1(SYS_SLEEP_NS, ns);
+    return evalynos_errno(out.error);
+}
+
+int Sysdeps<FutexWait>::operator()(int* uptr, int expected, timespec const* time) {
+    if (time) {
+        size_t ns = size_t(time->tv_sec) * 1000000000ull + size_t(time->tv_nsec);
+        auto out = syscall3(SYS_FUTEX_WAIT, size_t(uptr), expected, ns);
+        return evalynos_errno(out.error);
+    }
+
+    auto out = syscall3(SYS_FUTEX_WAIT, size_t(uptr), expected, 0);
+    return evalynos_errno(out.error);
+}
+
+int Sysdeps<FutexWake>::operator()(int* uptr, bool all) {
+    int count = all ? std::numeric_limits<int>::max() : 1;
+    auto out = syscall2(SYS_FUTEX_WAKE, size_t(uptr), count);
+    return evalynos_errno(out.error);
+}
+
+// partly stubbed to make them "work"
