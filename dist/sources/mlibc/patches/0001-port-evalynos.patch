+int Sysdeps<Write>::operator()(int fd, void const *buf, size_t size, ssize_t* ret) {
+    // the fd isnt stdout/stderr so fail
+    if (fd != 1 && fd != 2)
+        return EBADF;
+
+    const char* str = (const char*)buf;
+    for (size_t i = 0; i < size; i++)
+        syscall2(SYS_MISC_CTL, SYS_MISC_CTL_DBG_PUTC, (size_t)str[i]);
+
+    *ret = (ssize_t)size;
+    return 0;
+}
